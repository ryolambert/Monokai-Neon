{
  "name": "monokai-neon",
  "displayName": "Monokai Neon",
  "author": "Ryo Lambert",
  "publisher": "ryolambertdev",
  "description": "A source-built Monokai-inspired VS Code theme suite with contrast, storm, and OLED variants.",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "vscode",
    "theme",
    "monokai",
    "dark-theme",
    "syntax-highlighting",
    "open-vsx"
  ],
  "galleryBanner": {
    "color": "#0f1217",
    "theme": "dark"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "check": "node ./scripts/build.mjs --check",
    "package": "node ./scripts/package.mjs"
  },
  "files": [
    "themes/**/*.json",
    "assets/**/*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    "./theme": "./themes/Monokai Neon-color-theme.json",
    "./theme/contrast": "./themes/Monokai Neon Contrast-color-theme.json",
    "./theme/storm": "./themes/Monokai Neon Storm-color-theme.json",
    "./theme/oled": "./themes/Monokai Neon OLED-color-theme.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "contributes": {
    "themes": [
      {
        "label": "Monokai Neon",
        "uiTheme": "vs-dark",
        "path": "./themes/Monokai Neon-color-theme.json"
      },
      {
        "label": "Monokai Neon Contrast",
        "uiTheme": "vs-dark",
        "path": "./themes/Monokai Neon Contrast-color-theme.json"
      },
      {
        "label": "Monokai Neon Storm",
        "uiTheme": "vs-dark",
        "path": "./themes/Monokai Neon Storm-color-theme.json"
      },
      {
        "label": "Monokai Neon OLED",
        "uiTheme": "vs-dark",
        "path": "./themes/Monokai Neon OLED-color-theme.json"
      }
    ]
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ryolambert/Monokai-Neon/issues"
  },
  "homepage": "https://github.com/ryolambert/Monokai-Neon#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ryolambert/Monokai-Neon.git"
  }
}
