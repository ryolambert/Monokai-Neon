{
    "name": "monokai-neon",
    "displayName": "Monokai Neon",
    "author": "Ryo Lambert",
    "publisher": "ryolambertdev",
    "description": "Subtle variant on Monokai Vibrant with better contrast for dark and light working environments(i.e. ambient office lighting, hackers in dark rooms w/hoodies on, coding on out in the sun by the pool, etc.)",
    "galleryBanner": {
        "color": "#00ff0d",
        "theme": "dark"
    },
    "version": "0.0.2",
    "engines": {
        "vscode": "^1.40.0"
    },
    "categories": [
        "Themes"
    ],
    "contributes": {
        "themes": [
            {
                "label": "Monokai Neon",
                "uiTheme": "vs-dark",
                "path": "./themes/Monokai Neon-color-theme.json"
            }
        ]
    },
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/ryolambert/Monokai-Neon/issues"
    },
    "homepage": "https://github.com/ryolambert/Monokai-Neon#readme",
    "repository": {
        "type": "git",
        "url": "https://github.com/ryolambert/Monokai-Neon.git"
    },
    "icon": "assets/logo.png",
    "keywords": [
        "theme",
        "monokai",
        "dark theme",
        "neon",
        "syntax highlighting"
    ],
    "scripts": {
        "package": "pnpm dlx @vscode/vsce package",
        "publish:vscode": "pnpm dlx @vscode/vsce publish",
        "publish:openvsx": "pnpm dlx ovsx publish"
    },
    "packageManager": "pnpm@10.6.3"
}
