{
  "name": "Monokai Neon",
  "$schema": "vscode://schemas/color-theme",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#c7cbd8",
    "focusBorder": "#78a9ff",
    "activityBar.activeBorder": "#78a9ff",
    "activityBar.background": "#0f1217",
    "activityBar.foreground": "#f8f8f2",
    "activityBar.inactiveForeground": "#f8f8f2a3",
    "activityBarBadge.background": "#ff79c6",
    "activityBarBadge.foreground": "#0f1217",
    "badge.background": "#78a9ff",
    "badge.foreground": "#0f1217",
    "breadcrumb.background": "#171a1f",
    "breadcrumb.foreground": "#f8f8f2b8",
    "breadcrumb.activeSelectionForeground": "#f8f8f2",
    "button.background": "#78a9ff",
    "button.foreground": "#0f1217",
    "button.hoverBackground": "#66d9ef",
    "checkbox.background": "#1f2430",
    "checkbox.border": "#2b3140",
    "debugToolBar.background": "#1f2430",
    "descriptionForeground": "#f8f8f2b3",
    "dropdown.background": "#1f2430",
    "dropdown.border": "#2b3140",
    "dropdown.foreground": "#f8f8f2",
    "editor.background": "#171a1f",
    "editor.foreground": "#f8f8f2",
    "editor.lineHighlightBackground": "#202632",
    "editor.selectionBackground": "#33415ce6",
    "editor.inactiveSelectionBackground": "#293244e6",
    "editor.selectionHighlightBackground": "#78a9ff2e",
    "editor.wordHighlightBackground": "#66d9ef29",
    "editor.wordHighlightStrongBackground": "#ffb86c2e",
    "editor.findMatchBackground": "#c792eab3",
    "editor.findMatchHighlightBackground": "#66d9ef38",
    "editor.foldBackground": "#78a9ff17",
    "editor.hoverHighlightBackground": "#ffd86614",
    "editor.rangeHighlightBackground": "#ffb86c14",
    "editorLink.activeForeground": "#78a9ff",
    "editorCursor.foreground": "#f8f8f2",
    "editorError.foreground": "#ff6188",
    "editorWarning.foreground": "#ffd866",
    "editorInfo.foreground": "#66d9ef",
    "editorGroup.background": "#171a1f",
    "editorGroup.border": "#2b3140",
    "editorGroup.dropBackground": "#78a9ff2e",
    "editorGroupHeader.tabsBackground": "#12151a",
    "editorGutter.background": "#171a1f",
    "editorGutter.addedBackground": "#8be85a",
    "editorGutter.deletedBackground": "#ff6188",
    "editorGutter.modifiedBackground": "#66d9ef",
    "editorIndentGuide.background": "#2a3140",
    "editorIndentGuide.activeBackground": "#44506a",
    "editorLineNumber.foreground": "#8f98ade6",
    "editorLineNumber.activeForeground": "#f8f8f2",
    "editorOverviewRuler.border": "#2b3140",
    "editorOverviewRuler.addedForeground": "#8be85acc",
    "editorOverviewRuler.deletedForeground": "#ff6188cc",
    "editorOverviewRuler.modifiedForeground": "#66d9efcc",
    "editorOverviewRuler.errorForeground": "#ff6188e6",
    "editorOverviewRuler.warningForeground": "#ffd866e6",
    "editorOverviewRuler.infoForeground": "#66d9efe6",
    "editorSuggestWidget.background": "#1f2430",
    "editorSuggestWidget.border": "#2b3140",
    "editorSuggestWidget.foreground": "#f8f8f2",
    "editorSuggestWidget.highlightForeground": "#78a9ff",
    "editorSuggestWidget.selectedBackground": "#252b38",
    "editorWidget.background": "#1f2430",
    "editorWidget.border": "#2b3140",
    "gitDecoration.addedResourceForeground": "#8be85a",
    "gitDecoration.deletedResourceForeground": "#ff6188",
    "gitDecoration.modifiedResourceForeground": "#ffb86c",
    "input.background": "#1f2430",
    "input.border": "#2b3140",
    "input.foreground": "#f8f8f2",
    "input.placeholderForeground": "#8f98add9",
    "list.activeSelectionBackground": "#252b38",
    "list.activeSelectionForeground": "#f8f8f2",
    "list.focusOutline": "#78a9ff",
    "list.highlightForeground": "#78a9ff",
    "list.hoverBackground": "#252b38d9",
    "list.inactiveSelectionBackground": "#1f2430d9",
    "list.inactiveSelectionForeground": "#f8f8f2",
    "menu.background": "#1f2430",
    "menu.foreground": "#f8f8f2",
    "menu.selectionBackground": "#252b38",
    "menu.selectionForeground": "#f8f8f2",
    "minimap.background": "#0f1217bf",
    "minimap.selectionHighlight": "#78a9ff2e",
    "panel.background": "#12151a",
    "panel.border": "#2b3140",
    "panelTitle.activeForeground": "#f8f8f2",
    "panelTitle.inactiveForeground": "#f8f8f2a6",
    "peekView.border": "#78a9ff",
    "peekViewEditor.background": "#171a1f",
    "peekViewResult.background": "#12151a",
    "peekViewResult.selectionBackground": "#252b38",
    "peekViewTitle.background": "#0f1217",
    "scrollbarSlider.background": "#8f98ad40",
    "scrollbarSlider.hoverBackground": "#8f98ad66",
    "scrollbarSlider.activeBackground": "#8f98ad80",
    "sideBar.background": "#12151a",
    "sideBar.border": "#2b3140",
    "sideBar.foreground": "#c7cbd8",
    "sideBarSectionHeader.background": "#0f1217",
    "sideBarSectionHeader.foreground": "#f8f8f2",
    "statusBar.background": "#0f1217",
    "statusBar.foreground": "#f8f8f2",
    "statusBar.debuggingBackground": "#c792ea",
    "statusBar.noFolderBackground": "#0f1217",
    "statusBarItem.hoverBackground": "#252b38e6",
    "tab.activeBackground": "#171a1f",
    "tab.activeBorderTop": "#78a9ff",
    "tab.activeForeground": "#f8f8f2",
    "tab.border": "#2b3140",
    "tab.hoverBackground": "#1f2430",
    "tab.inactiveBackground": "#12151a",
    "tab.inactiveForeground": "#f8f8f2a6",
    "terminal.background": "#171a1f",
    "terminal.foreground": "#f8f8f2",
    "terminal.ansiBlack": "#525866",
    "terminal.ansiBlue": "#78a9ff",
    "terminal.ansiBrightBlack": "#7a8192",
    "terminal.ansiBrightBlue": "#66d9ef",
    "terminal.ansiBrightCyan": "#8be9fd",
    "terminal.ansiBrightGreen": "#b6ff8f",
    "terminal.ansiBrightMagenta": "#ff79c6",
    "terminal.ansiBrightRed": "#ff8fad",
    "terminal.ansiBrightWhite": "#ffffff",
    "terminal.ansiBrightYellow": "#fff19a",
    "terminal.ansiCyan": "#66d9ef",
    "terminal.ansiGreen": "#8be85a",
    "terminal.ansiMagenta": "#c792ea",
    "terminal.ansiRed": "#ff6188",
    "terminal.ansiWhite": "#c7cbd8",
    "terminal.ansiYellow": "#ffd866",
    "terminalCursor.background": "#f8f8f2",
    "terminalCursor.foreground": "#f8f8f2",
    "textLink.foreground": "#78a9ff",
    "textLink.activeForeground": "#66d9ef",
    "textPreformat.foreground": "#ffd866",
    "titleBar.activeBackground": "#0f1217",
    "titleBar.activeForeground": "#f8f8f2",
    "titleBar.inactiveBackground": "#0f1217",
    "titleBar.inactiveForeground": "#f8f8f2a6",
    "welcomePage.tileBackground": "#1f2430",
    "widget.border": "#2b3140",
    "editorBracketHighlight.foreground1": "#ff6188",
    "editorBracketHighlight.foreground2": "#ffb86c",
    "editorBracketHighlight.foreground3": "#ffd866",
    "editorBracketHighlight.foreground4": "#8be85a",
    "editorBracketHighlight.foreground5": "#66d9ef",
    "editorBracketHighlight.foreground6": "#c792ea",
    "editorBracketPairGuide.activeBackground1": "#ff6188",
    "editorBracketPairGuide.activeBackground2": "#ffb86c",
    "editorBracketPairGuide.activeBackground3": "#ffd866",
    "editorBracketPairGuide.activeBackground4": "#8be85a",
    "editorBracketPairGuide.activeBackground5": "#66d9ef",
    "editorBracketPairGuide.activeBackground6": "#c792ea",
    "editorBracketPairGuide.background1": "#ff618859",
    "editorBracketPairGuide.background2": "#ffb86c59",
    "editorBracketPairGuide.background3": "#ffd86659",
    "editorBracketPairGuide.background4": "#8be85a59",
    "editorBracketPairGuide.background5": "#66d9ef59",
    "editorBracketPairGuide.background6": "#c792ea59"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7f89a3",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#c792ea",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Modifiers & decorators",
      "scope": [
        "entity.name.function.decorator",
        "entity.name.type.module",
        "meta.annotation",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#ff6188"
      }
    },
    {
      "name": "Language constants",
      "scope": [
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "support.constant",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#c792ea"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "markup.inline.raw.string.markdown"
      ],
      "settings": {
        "foreground": "#ffd866"
      }
    },
    {
      "name": "String escapes and regex",
      "scope": [
        "constant.other.symbol",
        "string.regexp",
        "constant.character",
        "string.template punctuation.definition.string",
        "keyword.other.template"
      ],
      "settings": {
        "foreground": "#ffb86c"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float"
      ],
      "settings": {
        "foreground": "#ffb86c"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "support.function.any-method",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#8be85a"
      }
    },
    {
      "name": "Methods",
      "scope": [
        "meta.method",
        "meta.function.method",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#8be85a"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.interface",
        "support.type",
        "support.class",
        "support.type.primitive",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#66d9ef"
      }
    },
    {
      "name": "Namespaces",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "entity.name.package",
        "support.namespace"
      ],
      "settings": {
        "foreground": "#66d9ef"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameter.object-pattern",
        "meta.parameter.type.variable"
      ],
      "settings": {
        "foreground": "#ffb86c"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.object.property",
        "meta.object-literal.key",
        "support.variable.property",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#ffb86c"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "variable.other.constant",
        "entity.name.constant",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#ff6188"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "meta.tag",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#ff6188"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.css",
        "meta.attribute",
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#8be85a"
      }
    },
    {
      "name": "Selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "meta.selector.css",
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "#ff79c6"
      }
    },
    {
      "name": "JSON and YAML keys",
      "scope": [
        "support.type.property-name.json",
        "meta.object-literal.key.json",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#ffb86c"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "markup.heading.markdown",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#ff79c6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": [
        "markup.bold",
        "markup.italic",
        "markup.underline.link",
        "markup.quote.markdown"
      ],
      "settings": {
        "foreground": "#ffd866"
      }
    },
    {
      "name": "Markdown lists",
      "scope": [
        "beginning.punctuation.definition.list.markdown",
        "markup.list",
        "markup.raw.block.markdown"
      ],
      "settings": {
        "foreground": "#66d9ef"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link",
        "string.other.link.title",
        "markup.link",
        "markup.underline.link.image"
      ],
      "settings": {
        "foreground": "#78a9ff",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted",
        "diff.inserted",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#8be85a"
      }
    },
    {
      "name": "Diff removed",
      "scope": [
        "markup.deleted",
        "diff.deleted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#ff6188"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed",
        "diff.changed"
      ],
      "settings": {
        "foreground": "#ffd866"
      }
    },
    {
      "name": "Errors",
      "scope": [
        "invalid",
        "invalid.illegal",
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#ff6188",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#f8f8f2"
      }
    },
    {
      "name": "TypeScript specific",
      "scope": [
        "entity.name.type.alias.ts",
        "support.type.object.module.ts",
        "entity.name.type.module.ts",
        "storage.type.type.ts"
      ],
      "settings": {
        "foreground": "#66d9ef"
      }
    },
    {
      "name": "Python decorators",
      "scope": [
        "entity.name.function.decorator.python",
        "support.type.exception.python",
        "storage.type.annotation.python"
      ],
      "settings": {
        "foreground": "#ff6188"
      }
    },
    {
      "name": "Go declarations",
      "scope": [
        "entity.name.package.go",
        "entity.name.import.go",
        "storage.type.go"
      ],
      "settings": {
        "foreground": "#66d9ef"
      }
    },
    {
      "name": "Rust lifetimes and traits",
      "scope": [
        "storage.modifier.lifetime.rust",
        "support.type.rust",
        "entity.name.trait.rust"
      ],
      "settings": {
        "foreground": "#ffb86c"
      }
    },
    {
      "name": "Shell variables",
      "scope": [
        "variable.other.normal.shell",
        "variable.parameter.function.shell"
      ],
      "settings": {
        "foreground": "#ff6188"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#66d9ef",
    "class": "#66d9ef",
    "enum": "#66d9ef",
    "interface": "#66d9ef",
    "struct": "#66d9ef",
    "type": "#66d9ef",
    "typeParameter": "#ffb86c",
    "parameter": "#ffb86c",
    "variable": "#f8f8f2",
    "variable.readonly": "#ff6188",
    "property": "#ffb86c",
    "property.readonly": "#ff6188",
    "enumMember": "#ffb86c",
    "decorator": "#ff6188",
    "function": "#8be85a",
    "function.defaultLibrary": "#66d9ef",
    "method": "#8be85a",
    "method.defaultLibrary": "#66d9ef",
    "macro": "#ff6188",
    "label": "#ffd866",
    "regexp": "#66d9ef",
    "string.escape": "#ffb86c",
    "number": "#ffb86c",
    "keyword": "#c792ea",
    "comment": {
      "foreground": "#7f89a3",
      "fontStyle": "italic"
    }
  }
}
